{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://koriym.github.io/Koriym.SqlQuality/schema/explain-report.schema.json",
  "title": "Koriym.SqlQuality explain report",
  "description": "Output of `sql-quality explain --sql-file=FILE`.",
  "type": "object",
  "required": ["file", "sql", "executed", "skipped_reason", "cost", "execution_time_ms", "issues", "optimizer_impact", "context"],
  "additionalProperties": false,
  "properties": {
    "file": { "type": "string" },
    "sql": { "type": "string" },
    "executed": { "type": "boolean" },
    "skipped_reason": { "type": ["string", "null"] },
    "cost": { "type": "number" },
    "execution_time_ms": { "type": ["number", "null"] },
    "issues": {
      "type": "array",
      "items": { "$ref": "#/$defs/issue" }
    },
    "optimizer_impact": {
      "type": "object",
      "required": ["cost_reduction_percent"],
      "additionalProperties": false,
      "properties": {
        "cost_reduction_percent": { "type": "number" }
      }
    },
    "context": {
      "type": "object",
      "required": ["sql", "explain", "explain_analyze", "warnings", "schema"],
      "additionalProperties": false,
      "properties": {
        "sql": { "type": "string" },
        "explain": { "type": "object" },
        "explain_analyze": { "type": ["string", "null"] },
        "warnings": { "type": "array" },
        "schema": { "type": "object" }
      }
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "required": ["type", "message", "documentation", "severity", "confidence", "detector", "evidence", "suggestion"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "CartesianProduct",
            "DeepOffset",
            "DependentSubquery",
            "EstimateDivergence",
            "ExcessiveDerivedTables",
            "FunctionInvalidatesIndex",
            "FullTableScan",
            "ImplicitTypeConversion",
            "IneffectiveJoin",
            "IneffectiveLikePattern",
            "IneffectiveRangeScan",
            "IneffectiveSort",
            "IneffectiveUnion",
            "LowCardinalityIndex",
            "MultiTableUpdate",
            "OrderByRand",
            "TemporaryTableGrouping",
            "UnnecessaryDistinct"
          ]
        },
        "message": { "type": "string" },
        "documentation": { "type": "string", "format": "uri" },
        "severity": { "$ref": "#/$defs/severity" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "detector": { "type": "string" },
        "evidence": { "type": "object" },
        "suggestion": { "$ref": "#/$defs/suggestion" }
      }
    },
    "suggestion": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["kind", "description"],
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["index", "rewrite", "review"] },
            "description": { "type": "string" },
            "ddl": { "type": "string" },
            "sql": { "type": "string" }
          }
        }
      ]
    },
    "severity": { "enum": ["Critical", "Warning", "Info"] }
  }
}
