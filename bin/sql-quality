#!/usr/bin/env php
<?php

declare(strict_types=1);

namespace Koriym\SqlQuality;

use Koriym\SqlQuality\Exception\InvalidSeverityThreshold;
use Koriym\SqlQuality\Exception\RuntimeException;
use PDO;
use PDOException;
use stdClass;

use function array_slice;
use function basename;
use function count;
use function dirname;
use function file_exists;
use function fwrite;
use function in_array;
use function ini_set;
use function is_array;
use function is_string;
use function json_decode;
use function json_encode;
use function preg_match;
use function str_ends_with;
use function str_starts_with;

use const JSON_PRETTY_PRINT;
use const JSON_UNESCAPED_SLASHES;
use const JSON_UNESCAPED_UNICODE;
use const PHP_EOL;
use const STDERR;
use const STDOUT;

// Warnings and fatal errors must never land on stdout: that stream is reserved for the JSON report.
ini_set('display_errors', 'stderr');

// Find autoloader
$autoloadPaths = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$autoloaded = false;
foreach ($autoloadPaths as $autoloadPath) {
    if (file_exists($autoloadPath)) {
        require $autoloadPath;
        $autoloaded = true;
        break;
    }
}

if (! $autoloaded) {
    fwrite(STDERR, "Error: Could not find autoloader. Run 'composer install' first.\n");
    exit(1);
}

/**
 * SQL Quality CLI
 */
final class SqlQualityCli
{
    private const VERSION = '1.0.0';

    private const USAGE = <<<'USAGE'
SQL Quality Analyzer - Detect performance issues in SQL queries

Usage:
  sql-quality analyze [options]
  sql-quality explain [options]
  sql-quality --help
  sql-quality --version

Commands:
  analyze    Analyze SQL files for performance issues
  explain    Explain one SQL file and print structured JSON

Options:
  --sql-dir=DIR       Directory containing SQL files (analyze, required)
  --sql-file=FILE     Single SQL file to explain (explain, required)
  --params=FILE       PHP file returning SQL parameters array (analyze, required)
  --params=JSON|FILE  Inline JSON object or PHP file (explain, default: {})
  --dsn=DSN           Database DSN (default: mysql:host=127.0.0.1;dbname=test)
  --user=USER         Database user (default: root)
  --password=PASS     Database password (default: empty)
  --format=FORMAT     Output format: json or markdown (analyze, default: json)
  --output=DIR        Output directory for markdown reports (required with --format=markdown)
  --fail-on=LEVEL     Exit 1 when an issue of critical, warning or info level
                      or above is found (default: never exit 1)
  --lang=LANG         Language for messages: en or ja (default: en)
  --help              Show this help message
  --version           Show version

Exit codes:
  0  No issue reached the --fail-on level
  1  An issue reached the --fail-on level
  2  Usage, database connection, params or SQL file error

Examples:
  sql-quality analyze --sql-dir=sql/ --params=params.php --format=json
  sql-quality analyze --sql-dir=sql/ --params=params.php --fail-on=critical
  sql-quality analyze --sql-dir=sql/ --params=params.php --dsn="mysql:host=localhost;dbname=mydb"
  sql-quality explain --sql-file=sql/1_full_table_scan.sql --params='{"min_views":1000}'

USAGE;

    private const MESSAGES_EN = [
        'CartesianProduct'         => 'Cartesian product detected.',
        'DeepOffset'               => 'Deep OFFSET detected.',
        'DependentSubquery'        => 'Dependent subquery detected.',
        'EstimateDivergence'       => 'Row estimate diverges from the actual row count.',
        'ExcessiveDerivedTables'    => 'Excessive use of derived tables detected.',
        'FunctionInvalidatesIndex'  => 'Function invalidates index.',
        'FullTableScan'            => 'Full table scan detected.',
        'ImplicitTypeConversion'   => 'Implicit type conversion detected.',
        'IneffectiveJoin'          => 'Ineffective join detected.',
        'IneffectiveLikePattern'   => 'Ineffective LIKE pattern detected.',
        'IneffectiveRangeScan'     => 'Ineffective range scan detected.',
        'IneffectiveSort'          => 'Ineffective sort operation detected.',
        'IneffectiveUnion'         => 'Ineffective UNION usage detected.',
        'LowCardinalityIndex'      => 'Index on low cardinality column detected.',
        'MultiTableUpdate'         => 'Multi-table update detected.',
        'OrderByRand'              => 'ORDER BY RAND() detected.',
        'TemporaryTableGrouping'   => 'Temporary table required for grouping.',
        'UnnecessaryDistinct'      => 'Unnecessary DISTINCT detected.',
    ];

    private const MESSAGES_JA = [
        'CartesianProduct'         => 'カーテシアン積が検出されました。',
        'DeepOffset'               => '大きなOFFSETが検出されました。',
        'DependentSubquery'        => '依存サブクエリが検出されました。',
        'EstimateDivergence'       => '見積もり行数と実際の行数に乖離があります。',
        'ExcessiveDerivedTables'    => '派生テーブルの過度な使用が検出されました。',
        'FunctionInvalidatesIndex'  => '関数の使用によりインデックスが無効化されています。',
        'FullTableScan'            => 'フルテーブルスキャンが検出されました。',
        'ImplicitTypeConversion'   => '暗黙的な型変換が検出されました。',
        'IneffectiveJoin'          => '非効率的な結合が検出されました。',
        'IneffectiveLikePattern'   => '非効率的なLIKEパターンが検出されました。',
        'IneffectiveRangeScan'     => '非効率的な範囲スキャンが検出されました。',
        'IneffectiveSort'          => '非効率的なソート操作が検出されました。',
        'IneffectiveUnion'         => '非効率的なUNIONの使用が検出されました。',
        'LowCardinalityIndex'      => 'カーディナリティの低い列にインデックスが設定されています。',
        'MultiTableUpdate'         => '複数テーブルの更新が検出されました。',
        'OrderByRand'              => 'ORDER BY RAND()が検出されました。',
        'TemporaryTableGrouping'   => 'グループ化のために一時テーブルが必要です。',
        'UnnecessaryDistinct'      => '不必要なDISTINCTが検出されました。',
    ];

    /** @param list<string> $argv */
    public function run(array $argv): int
    {
        // Check for help/version before parsing
        if (count($argv) < 2 || in_array('--help', $argv, true)) {
            echo self::USAGE;
            return 0;
        }

        if (in_array('--version', $argv, true)) {
            echo 'sql-quality version ' . self::VERSION . PHP_EOL;
            return 0;
        }

        $command = $argv[1] ?? '';
        if (! in_array($command, ['analyze', 'explain'], true)) {
            fwrite(STDERR, "Unknown command: {$command}\n");
            fwrite(STDERR, "Run 'sql-quality --help' for usage.\n");
            return 2;
        }

        // Parse options manually from argv
        $options = $this->parseOptions(array_slice($argv, 2));

        try {
            return $command === 'analyze' ? $this->analyze($options) : $this->explain($options);
        } catch (InvalidSeverityThreshold $e) {
            fwrite(STDERR, "Error: --fail-on accepts critical, warning or info, not: {$e->getMessage()}\n");

            return 2;
        } catch (RuntimeException $e) {
            fwrite(STDERR, "Error: {$e->getMessage()}\n");

            return 2;
        } catch (PDOException $e) {
            fwrite(STDERR, "Error: Database connection failed: {$e->getMessage()}\n");

            return 2;
        }
    }

    /**
     * @param list<string> $args
     * @return array<string, string|false>
     */
    private function parseOptions(array $args): array
    {
        $options = [];
        foreach ($args as $arg) {
            if (preg_match('/^--([^=]+)=(.*)$/', $arg, $matches)) {
                $options[$matches[1]] = $matches[2];
            } elseif (preg_match('/^--([^=]+)$/', $arg, $matches)) {
                $options[$matches[1]] = false;
            }
        }
        return $options;
    }

    /**
     * @param array<string, string|false> $options
     *
     * @throws InvalidSeverityThreshold
     * @throws PDOException
     */
    private function analyze(array $options): int
    {
        $sqlDir = $options['sql-dir'] ?? null;
        $paramsFile = $options['params'] ?? null;

        if (! is_string($sqlDir) || ! is_string($paramsFile)) {
            fwrite(STDERR, "Error: --sql-dir and --params are required.\n");

            return 2;
        }

        if (! file_exists($sqlDir)) {
            fwrite(STDERR, "Error: SQL directory not found: {$sqlDir}\n");

            return 2;
        }

        if (! file_exists($paramsFile)) {
            fwrite(STDERR, "Error: Params file not found: {$paramsFile}\n");

            return 2;
        }

        $format = (string) ($options['format'] ?? 'json');
        if ($format !== 'json' && $format !== 'markdown') {
            fwrite(STDERR, "Error: --format accepts json or markdown, not: {$format}\n");

            return 2;
        }

        $outputDir = $options['output'] ?? null;
        if ($format === 'markdown' && ! is_string($outputDir)) {
            fwrite(STDERR, "Error: --output=DIR is required with --format=markdown.\n");

            return 2;
        }

        $threshold = $this->parseFailOnThreshold($options);
        $pdo = $this->connectPdo($options);

        $sqlParams = require $paramsFile;
        if (! is_array($sqlParams)) {
            fwrite(STDERR, "Error: Params file must return an array: {$paramsFile}\n");

            return 2;
        }

        foreach ($sqlParams as $sqlFile => $params) {
            if (! is_string($sqlFile) || ! is_array($params)) {
                fwrite(STDERR, "Error: Params file entry for '{$sqlFile}' must map a SQL file name to an array: {$paramsFile}\n");

                return 2;
            }
        }

        /** @var array<string, array<string, mixed>> $sqlParams */
        $analyzer = $this->buildAnalyzer($pdo, $sqlDir, $options);

        $run = $analyzer->analyzeSQLFiles($sqlParams);
        $exitCode = $threshold !== null && $threshold->isMetBy($run) ? 1 : 0;

        if ($format === 'markdown') {
            /** @var string $outputDir */
            $analyzer->saveReports($run['results'], $outputDir);
            fwrite(STDERR, "Markdown reports saved to: {$outputDir}\n");
            foreach ($run['skipped'] as $sqlFile => $reason) {
                fwrite(STDERR, "Skipped {$sqlFile}: {$reason}\n");
            }

            return $exitCode;
        }

        $report = (new JsonReportGenerator())->generate($run);
        fwrite(STDOUT, json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . PHP_EOL);

        return $exitCode;
    }

    /**
     * @param array<string, string|false> $options
     *
     * @throws InvalidSeverityThreshold
     * @throws PDOException
     */
    private function explain(array $options): int
    {
        $sqlFile = $options['sql-file'] ?? null;
        if (! is_string($sqlFile) || $sqlFile === '') {
            fwrite(STDERR, "Error: --sql-file is required.\n");

            return 2;
        }

        if (! file_exists($sqlFile)) {
            fwrite(STDERR, "Error: SQL file not found: {$sqlFile}\n");

            return 2;
        }

        $sqlFileName = basename($sqlFile);
        $params = $this->resolveExplainParams($sqlFileName, $options['params'] ?? null);
        if ($params === null) {
            return 2;
        }

        $threshold = $this->parseFailOnThreshold($options);
        $pdo = $this->connectPdo($options);
        $analyzer = $this->buildAnalyzer($pdo, dirname($sqlFile), $options);

        try {
            ['result' => $result, 'context' => $context] = $analyzer->explain($sqlFileName, $params);
        } catch (RuntimeException | PDOException $e) {
            fwrite(STDERR, 'Error: ' . SqlFileAnalyzer::exceptionLabel($e) . ": {$e->getMessage()}\n");

            return 2;
        }

        $exitCode = $threshold !== null && $threshold->isMetBy(['results' => [$sqlFileName => $result], 'skipped' => []]) ? 1 : 0;

        // context.schema is an associative array keyed by table name; a table-free query leaves it
        // empty, and json_encode() would emit [] there instead of the {} the schema requires.
        $contextData = $context->toArray();
        $contextData['schema'] = $contextData['schema'] === [] ? new stdClass() : $contextData['schema'];

        $report = [
            'file' => $sqlFileName,
            'sql' => $context->sql,
            'executed' => $result['executed'],
            'skipped_reason' => $result['skipped_reason'],
            'cost' => $result['cost'],
            'execution_time_ms' => $result['executed'] ? $result['execution_time'] * 1000 : null,
            'issues' => $result['issues'],
            'optimizer_impact' => ['cost_reduction_percent' => JsonReportGenerator::costReductionPercent($result['optimizer_comparison']['difference']['cost_percent'])],
            'context' => $contextData,
        ];

        fwrite(STDOUT, json_encode($report, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES) . PHP_EOL);

        return $exitCode;
    }

    /**
     * @param array<string, string|false> $options
     *
     * @throws InvalidSeverityThreshold
     */
    private function parseFailOnThreshold(array $options): SeverityThreshold|null
    {
        $failOn = $options['fail-on'] ?? null;
        if ($failOn === null) {
            return null;
        }

        return new SeverityThreshold(is_string($failOn) ? $failOn : '');
    }

    /**
     * @param array<string, string|false> $options
     *
     * @throws PDOException
     */
    private function connectPdo(array $options): PDO
    {
        $dsn = (string) ($options['dsn'] ?? 'mysql:host=127.0.0.1;dbname=test');
        $user = (string) ($options['user'] ?? 'root');
        $password = (string) ($options['password'] ?? '');

        return new PDO($dsn, $user, $password, [PDO::ATTR_ERRMODE => PDO::ERRMODE_EXCEPTION]);
    }

    /** @param array<string, string|false> $options */
    private function buildAnalyzer(PDO $pdo, string $sqlDir, array $options): SqlFileAnalyzer
    {
        $lang = $options['lang'] ?? 'en';
        $messages = $lang === 'ja' ? self::MESSAGES_JA : self::MESSAGES_EN;
        $instruction = $lang === 'ja'
            ? '以上の分析を日本語で記述してください。'
            : 'Please provide your analysis in English.';

        return new SqlFileAnalyzer(
            $pdo,
            new ExplainAnalyzer($messages),
            $sqlDir,
            new AIQueryAdvisor($instruction),
            new OptimizerSettings($pdo),
        );
    }

    /** @return array<string, mixed>|null null means the value was invalid and an error was already written */
    private function resolveExplainParams(string $sqlFileName, string|false|null $paramsOption): array|null
    {
        if ($paramsOption === null) {
            return [];
        }

        if ($paramsOption === false) {
            fwrite(STDERR, "Error: --params requires a value.\n");

            return null;
        }

        if (str_starts_with($paramsOption, '{')) {
            $decoded = json_decode($paramsOption, true);
            if (! is_array($decoded)) {
                fwrite(STDERR, "Error: --params is not valid JSON: {$paramsOption}\n");

                return null;
            }

            /** @var array<string, mixed> $decoded */
            return $decoded;
        }

        if (! file_exists($paramsOption)) {
            fwrite(STDERR, "Error: Params file not found: {$paramsOption}\n");

            return null;
        }

        $decoded = require $paramsOption;
        if (! is_array($decoded)) {
            fwrite(STDERR, "Error: Params file must return an array: {$paramsOption}\n");

            return null;
        }

        if ($this->isKeyedBySqlFile($decoded)) {
            /** @var array<string, array<string, mixed>> $decoded */
            return $decoded[$sqlFileName] ?? [];
        }

        /** @var array<string, mixed> $decoded */
        return $decoded;
    }

    /** @param array<array-key, mixed> $decoded */
    private function isKeyedBySqlFile(array $decoded): bool
    {
        if ($decoded === []) {
            return false;
        }

        foreach ($decoded as $key => $value) {
            if (! is_string($key) || ! str_ends_with($key, '.sql') || ! is_array($value)) {
                return false;
            }
        }

        return true;
    }
}

// Run CLI
$cli = new SqlQualityCli();
exit($cli->run($argv));
