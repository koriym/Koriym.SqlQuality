#!/usr/bin/env php
<?php

declare(strict_types=1);

use Koriym\SqlQuality\Cli;

// Warnings and fatal errors must never land on stdout: that stream is reserved for the JSON report.
ini_set('display_errors', 'stderr');

$autoloaded = false;
foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoloadPath) {
    if (file_exists($autoloadPath)) {
        require $autoloadPath;
        $autoloaded = true;
        break;
    }
}

if (! $autoloaded) {
    fwrite(STDERR, "Error: Could not find autoloader. Run 'composer install' first.\n");
    exit(2);
}

/** @var list<string> $argv */
exit((new Cli(STDOUT, STDERR, STDIN))->run($argv));
